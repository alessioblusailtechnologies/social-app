---
// Il telefono dell'hero: tre schermate dell'app, si cambia coi pallini sotto.
const screens = [
  { id: 'plan', label: 'Piano della settimana', caption: 'Il piano della settimana, nell’app' },
  { id: 'draft', label: 'Bozza da rivedere', caption: 'Le bozze, scritte con la tua voce' },
  { id: 'visual', label: 'Visivi del brand', caption: 'I visivi, nei tuoi colori' },
];
const days = ['Lun', 'Mar', 'Mer', 'Gio', 'Ven'];
const palette = ['#E9713C', '#2D3050', '#F2926A', '#FFFFFF'];
---

<div class="showcase" data-showcase>
  <p class="showcase__caption" aria-live="polite" data-caption>{screens[0].caption}</p>

  <div class="showcase__stage">
    <div class="showcase__glow" aria-hidden="true"></div>
    <div class="phone">
      <div class="phone__screen">
        <div class="phone__status" aria-hidden="true">
          <span>9:41</span>
          <span class="phone__battery"></span>
        </div>

        <div class="screen" id="screen-plan" data-screen>
          <div class="screen__head">
            <p class="screen__kicker">Settimana 12–18 maggio</p>
            <p class="screen__title">Il tuo piano</p>
          </div>
          <div class="days">
            {days.map((d, i) => <span class:list={['day', { 'day--active': i === 0 }]}>{d}</span>)}
          </div>
          <div class="slots">
            <div class="slot">
              <p class="slot__meta slot__meta--accent"><span class="dot" aria-hidden="true"></span>LinkedIn · 09:00</p>
              <p class="slot__title">Tre errori che vedo nei brief dei clienti</p>
              <p class="slot__note">Bozza pronta · tono diretto</p>
            </div>
            <div class="slot">
              <p class="slot__meta"><span class="dot dot--muted" aria-hidden="true"></span>Instagram · 18:30</p>
              <div class="slot__row">
                <div class="stripes slot__thumb" aria-hidden="true"></div>
                <p class="slot__title">Carosello: il dietro le quinte del progetto</p>
              </div>
            </div>
            <div class="slot slot--dark">
              <p>4 bozze da rivedere</p>
              <span class="slot__chip">Apri</span>
            </div>
          </div>
        </div>

        <div class="screen" id="screen-draft" data-screen hidden>
          <p class="screen__kicker">Mercoledì · LinkedIn</p>
          <p class="screen__title">Bozza da rivedere</p>
          <div class="draft">
            <p class="draft__hook">Tre errori che vedo nei brief dei clienti — e come li sistemo in mezz'ora.</p>
            <p class="draft__body">Il primo: <mark>nessuno ha scritto chi decide</mark>. Il secondo: obiettivi senza un numero. Il terzo…</p>
            <p class="slot__meta draft__meta"><span class="dot" aria-hidden="true"></span>Tono: diretto · 780 caratteri</p>
          </div>
          <div class="draft__actions">
            <span class="draft__btn draft__btn--dark">Approva</span>
            <span class="draft__btn">Riscrivi</span>
          </div>
          <p class="screen__footnote">Ogni correzione che fai insegna a Moonbrand come scrivi.</p>
        </div>

        <div class="screen" id="screen-visual" data-screen hidden>
          <p class="screen__kicker">Carosello · Instagram</p>
          <p class="screen__title">Visivi nel tuo stile</p>
          <div class="tiles">
            <div class="tile tile--ink">3 errori nei brief</div>
            <div class="tile stripes tile--photo"><span>foto studio</span></div>
            <div class="tile tile--accent">Chi decide?</div>
            <div class="tile tile--light">Scrivimi in DM</div>
          </div>
          <div class="palette">
            <span class="palette__label">Palette</span>
            {palette.map((c) => <span class="palette__swatch" style={`background: ${c}`}></span>)}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="showcase__dots">
    {
      screens.map((s, i) => (
        <button
          class="showcase__dot"
          type="button"
          aria-label={s.label}
          aria-controls={`screen-${s.id}`}
          aria-current={i === 0 ? 'true' : undefined}
          data-dot
          data-caption-text={s.caption}
        />
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    const caption = root.querySelector<HTMLElement>('[data-caption]');
    const screens = root.querySelectorAll<HTMLElement>('[data-screen]');
    const dots = root.querySelectorAll<HTMLButtonElement>('[data-dot]');

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        screens.forEach((screen, j) => (screen.hidden = i !== j));
        dots.forEach((d, j) => (i === j ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
        if (caption) caption.textContent = dot.dataset.captionText ?? '';
      });
    });
  });
</script>

<style>
  .showcase {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .showcase__caption {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    color: var(--ink-faint);
  }

  .showcase__stage {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .showcase__glow {
    position: absolute;
    inset: 6% 12%;
    background: radial-gradient(circle at 50% 40%, rgb(233 113 60 / 0.22), rgb(233 113 60 / 0) 70%);
    filter: blur(10px);
  }

  .phone {
    position: relative;
    width: 300px;
    max-width: 100%;
    padding: 11px;
    border-radius: 42px;
    background: var(--ink);
    box-shadow: 0 30px 60px rgb(45 48 80 / 0.28);
    animation: float 7s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .phone__screen {
    overflow: hidden;
    border-radius: 32px;
    background: var(--screen);
  }

  .phone__status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 20px 6px;
    font-size: 12px;
    font-weight: 600;
  }

  .phone__battery {
    width: 16px;
    height: 8px;
    border: 1.5px solid currentColor;
    border-radius: 2px;
  }

  /* Le schermate */

  .screen {
    min-height: 376px;
    padding: 10px 18px 20px;
    animation: screen-in 260ms ease-out;
  }

  .screen[hidden] {
    display: none;
  }

  @keyframes screen-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  #screen-plan {
    padding-inline: 0;
  }

  .screen__head {
    padding: 0 18px 6px;
  }

  .screen__kicker {
    font-size: 12.5px;
    color: rgb(45 48 80 / 0.55);
  }

  .screen__title {
    margin-top: 3px;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
  }

  .screen__footnote {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.45;
    color: var(--ink-faint);
  }

  .days {
    display: flex;
    gap: 7px;
    padding: 12px 18px 4px;
  }

  .day {
    flex: 1;
    padding: 7px 0;
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink-subtle);
    font-size: 11px;
    font-weight: 600;
    text-align: center;
    text-transform: uppercase;
  }

  .day--active {
    background: var(--accent);
    color: #fff;
  }

  .slots {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px 18px 0;
  }

  .slot {
    padding: 13px 14px;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: 0 2px 8px rgb(45 48 80 / 0.06);
  }

  .slot__meta {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .slot__meta--accent {
    color: var(--accent-strong);
  }

  .dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .dot--muted {
    background: rgb(45 48 80 / 0.3);
  }

  .slot__title {
    margin-top: 7px;
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.4;
  }

  .slot__note {
    margin-top: 6px;
    font-size: 12px;
    line-height: 1.45;
    color: var(--ink-subtle);
  }

  .slot__row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 9px;
  }

  .slot__row .slot__title {
    margin-top: 0;
  }

  .slot__thumb {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 12px;
  }

  .stripes {
    background: repeating-linear-gradient(135deg, var(--accent) 0 6px, var(--accent-soft) 6px 12px);
  }

  .slot--dark {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: var(--ink);
    color: #fff;
    font-size: 13px;
    line-height: 1.35;
    box-shadow: none;
  }

  .slot__chip {
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--accent);
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  .draft {
    margin-top: 14px;
    padding: 15px 15px 13px;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: 0 2px 8px rgb(45 48 80 / 0.06);
  }

  .draft__hook {
    font-size: 13.5px;
    line-height: 1.5;
  }

  .draft__body {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .draft__body mark {
    padding: 1px 3px;
    border-radius: 4px;
    background: rgb(233 113 60 / 0.18);
    color: inherit;
  }

  .draft__meta {
    margin-top: 12px;
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  .draft__actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }

  .draft__btn {
    flex: 1;
    padding: 11px 0;
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 2px 8px rgb(45 48 80 / 0.06);
    font-size: 13px;
    font-weight: 600;
    text-align: center;
  }

  .draft__btn--dark {
    background: var(--ink);
    color: #fff;
    box-shadow: none;
  }

  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px;
    margin-top: 14px;
  }

  .tile {
    aspect-ratio: 1;
    display: flex;
    align-items: flex-end;
    padding: 12px;
    border-radius: 14px;
    font-family: var(--font-display);
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.25;
  }

  .tile--ink {
    background: var(--ink);
    color: #fff;
  }

  .tile--accent {
    background: var(--accent);
    color: #fff;
  }

  .tile--light {
    background: var(--surface);
    box-shadow: 0 2px 8px rgb(45 48 80 / 0.06);
  }

  .tile--photo {
    align-items: center;
    justify-content: center;
    background: repeating-linear-gradient(135deg, var(--accent) 0 7px, var(--accent-soft) 7px 14px);
  }

  .tile--photo span {
    padding: 4px 7px;
    border-radius: 6px;
    background: rgb(45 48 80 / 0.55);
    color: #fff;
    font-family: ui-monospace, monospace;
    font-size: 9.5px;
    font-weight: 400;
  }

  .palette {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
  }

  .palette__label {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .palette__swatch {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(45 48 80 / 0.15);
  }

  /* I pallini */

  .showcase__dots {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .showcase__dot {
    position: relative;
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgb(45 48 80 / 0.22);
    cursor: pointer;
    transition:
      width 200ms ease,
      background-color 200ms ease;
  }

  /* Area da toccare più grande del pallino. */
  .showcase__dot::after {
    content: '';
    position: absolute;
    inset: -10px -4px;
  }

  .showcase__dot[aria-current='true'] {
    width: 26px;
    background: var(--ink);
  }
</style>
