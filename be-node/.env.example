# Puntamenti del BE di Presenza: copiare in .env e compilare.
# .env NON va mai committato (è in be-node/.gitignore).
#
# Il progetto Supabase è quello di sviluppo condiviso con Velia (assieme/be-node):
# Presenza vive nello schema dedicato `presenza` e si collega col ruolo `presenza_app`.

# Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Solo registrazione (Admin API di Auth): scavalca la RLS, trattarla come una password.
SUPABASE_SERVICE_ROLE_KEY=
# Progetti con chiavi JWT legacy (HS256). Senza, i token si verificano col JWKS del progetto.
SUPABASE_JWT_SECRET=

# Ruolo `presenza_app`, pooler in modalità sessione (porta 5432).
# Lo scrive `npm run db:password`, che genera anche la password.
DATABASE_URL=

# Solo per gli strumenti in tools/ (Management API): migrazioni e password del ruolo.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_POOLER_HOST=aws-1-eu-north-1.pooler.supabase.com

# L'AI (Agent SDK). Senza la chiave del fornitore del modello le rotte AI rispondono 503, il resto funziona.
# Il modello: un Claude (da Anthropic) o `deepseek-flash` / `deepseek-v4-pro` (da DeepSeek).
# AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# DeepSeek diretta (API compatibile con Anthropic, cache automatica), per i modelli `deepseek-*`.
# ATTENZIONE: server in Cina, sito, brand e testi escono dall'UE.
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# Profondità del ragionamento per le generazioni; i ritocchi rapidi girano sempre a `low`. Solo con Claude.
# AI_EFFORT=medium
# Tetto di tempo e di spesa per ogni generazione. Il tetto di spesa vale solo con Claude.
# AI_TIMEOUT_MS=240000
# AI_MAX_BUDGET_USD=1

API_PORT=3010
LOG_LEVEL=info
# Origini del FE ammesse (separate da virgola): il dev server web di Expo.
CORS_ORIGINS=http://localhost:8082,http://localhost:8081
# Il fuso in cui si leggono le date del piano e il "oggi" della Home.
# APP_TIME_ZONE=Europe/Rome
